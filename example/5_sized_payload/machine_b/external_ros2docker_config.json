{
  "container_name": "machine_b_logic",

  "run_type": "command",
  "command": ["ros2", "run", "com_py", "sized_publisher", "--ros-args", "-p", "topic:=/size_test", "-p", "size:=62000", "-p", "rate:=10.0"],

  "run_args": [ 
    "--network", "host", 
    "-e", "ROS_DOMAIN_ID=47"
