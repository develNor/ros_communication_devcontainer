<?xml version="1.0" encoding="UTF-8"?>
<!--
  Fast DDS "easy mode": discovery by Discovery Server instead of multicast.

  Fast DDS 3.1 spawns (or reuses) one Discovery Server per host and points the
  participant at the peer's server as well, so two hosts find each other with no
  multicast and no per-participant peer list. It is the answer Fast DDS gives to
  the problem `fastdds_tuned.xml` solves with `initialPeersList`, and the reason
  to keep both is that they fail differently: an explicit peer list cannot
  discover anything it was not told about, while easy mode depends on a server
  process being reachable on 11811.

  Data transport is NOT discovery, and easy mode does not change it. The cap
  below is the same 1200 B every other OTA template sets, expressed as an
  attribute on the builtin transports rather than a custom
  `<transport_descriptor>`: easy mode configures its own transport mix, and
  replacing it with `useBuiltinTransports=false` would take the discovery-server
  path with it.

  `#easy_mode_ip` resolves to the peer's address (override per side with
  `shared.rmw.{local|ota}.fastdds.easy_mode_ip`).
-->
<dds xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <profiles>
    <participant profile_name="rosotacom_fastdds_easy_mode" is_default_profile="true">
      <rtps>
        <easy_mode_ip>#easy_mode_ip</easy_mode_ip>

        <!-- One RTPS datagram never exceeds this, so a 38 kB camera keyframe
             becomes ~32 independent fragments instead of ~27 IP fragments the
             peer has to reassemble as a unit. non_blocking drops rather than
             stalls the writer when the socket buffer is full. -->
        <builtinTransports max_msg_size="1200" sockets_size="1MB" non_blocking="true">UDPv4</builtinTransports>
      </rtps>
    </participant>

    <data_writer profile_name="rosotacom_fastdds_easy_mode_writer" is_default_profile="true">
      <qos>
        <data_sharing>
          <kind>OFF</kind>
        </data_sharing>
      </qos>
    </data_writer>

    <data_reader profile_name="rosotacom_fastdds_easy_mode_reader" is_default_profile="true">
      <qos>
        <data_sharing>
          <kind>OFF</kind>
        </data_sharing>
      </qos>
    </data_reader>
  </profiles>
</dds>
