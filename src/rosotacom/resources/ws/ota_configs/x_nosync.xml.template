<?xml version="1.0" encoding="UTF-8"?>
<!--
  Fast DDS on a real OTA link: the peer of cyclonedds_tuned.xml.

  fastdds_unicast.xml pins the locators and nothing else, which is enough on a
  LAN and not enough on a cellular tunnel. Everything below is the Fast DDS
  spelling of a knob cyclonedds_tuned.xml already sets, so a session can change
  `shared.rmw` and keep the same link behaviour:

    Cyclone <FragmentSize>/<MaxMessageSize>1200B  ->  <maxMessageSize>1200
    Cyclone <Interfaces><NetworkInterface>        ->  <interfaces><allowlist>
    Cyclone <AllowMulticast>false                 ->  unicast locator lists only
    Cyclone <Discovery><Peers>                    ->  <initialPeersList>
    Cyclone <LeaseDuration>60s                    ->  <leaseDuration>

  The fragment size is the one that decides whether the link works. Left at the
  Fast DDS default (65500 B) a 38 kB camera keyframe leaves the host as ONE UDP
  datagram, which the kernel then splits into ~27 IP fragments that the peer
  must reassemble as a unit: a single lost fragment costs the whole message,
  the reassembly queue is a shared resource under a burst, and OpenVPN adds its
  own fragmentation barrier on top (~110 kB in the measured baseline). At
  1200 B the same message is 32 independent RTPS fragments, which is what
  CycloneDDS has always sent here.

  <non_blocking_send> keeps the writer out of the queue: when the socket buffer
  is full the datagram is dropped instead of blocking the publishing thread.
  On a shaped uplink the blocking default turns a link-layer backlog into
  application-level latency, which is the "delay builds up" failure mode.

  Fragmented data requires asynchronous publication, and the mode has to be set
  HERE. The runtime also exports RMW_FASTRTPS_PUBLICATION_MODE=ASYNCHRONOUS, but
  that only supplies rmw_fastrtps's default: with
  RMW_FASTRTPS_USE_QOS_FROM_XML=1 -- which the runtime sets whenever an OTA
  profile file exists -- a DataWriter's publish mode comes from the XML profile,
  and a profile that says nothing means SYNCHRONOUS. A synchronous writer cannot
  fragment, so every sample larger than the cap above is simply never sent:
  measured on the lamborghini/majestic pair (2026-08-18), an 84 B heartbeat
  crossed at 10 Hz while a 12 kB stream on the same link never reached the
  bridge at all.
-->
<dds xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <profiles>
    <transport_descriptors>
      <transport_descriptor>
        <transport_id>rosotacom_ota_udp</transport_id>
        <type>UDPv4</type>

        <!-- One RTPS datagram never exceeds this, so the kernel never sees an
             oversized datagram to fragment. Matches Cyclone's 1200 B. -->
        <maxMessageSize>1200</maxMessageSize>
        <sendBufferSize>1048576</sendBufferSize>
        <receiveBufferSize>8388608</receiveBufferSize>

        <!-- Drop rather than block when the socket buffer is full. -->
        <non_blocking_send>true</non_blocking_send>

        <!-- Two addresses, and both are load-bearing. #host_ip is the OTA
             address, and pinning it is what keeps a multi-homed VPN host from
             announcing a locator the peer cannot route to. 127.0.0.1 is the
             same-host half: with a split OTA domain the stock `domain_bridge`
             process sits on that domain too and speaks whatever RMW the local
             side uses, so this participant has to be able to discover a peer on
             its own machine. An allowlist of the OTA address alone takes the
             loopback path away and the bridge and the OTA processes never see
             each other -- the failure looks like a dead link and is not one. -->
        <interfaces>
          <allowlist>
            <interface name="127.0.0.1" netmask_filter="OFF"/>
            <interface name="#host_ip" netmask_filter="OFF"/>
          </allowlist>
        </interfaces>

        <!-- An initial peer without a port makes Fast DDS probe participant
             indices 0..maxInitialPeersRange on that address. The default is 4,
             and an OTA domain carrying a bridge plus the IN/OUT splits can
             hand out a higher index than that -- whichever process starts late
             is then simply never found. CycloneDDS probes 10 by default; this
             matches it. -->
        <maxInitialPeersRange>10</maxInitialPeersRange>
      </transport_descriptor>
    </transport_descriptors>

    <participant profile_name="rosotacom_fastdds_tuned" is_default_profile="true">
      <rtps>
        <defaultUnicastLocatorList>
          <locator>
            <udpv4>
              <address>127.0.0.1</address>
              <port>0</port>
            </udpv4>
          </locator>
          <locator>
            <udpv4>
              <address>#host_ip</address>
              <port>0</port>
            </udpv4>
          </locator>
        </defaultUnicastLocatorList>

        <builtin>
          <metatrafficUnicastLocatorList>
            <locator>
              <udpv4>
                <address>127.0.0.1</address>
                <port>0</port>
              </udpv4>
            </locator>
            <locator>
              <udpv4>
                <address>#host_ip</address>
                <port>0</port>
              </udpv4>
            </locator>
          </metatrafficUnicastLocatorList>

          <initialPeersList>
            <locator>
              <udpv4>
                <address>127.0.0.1</address>
                <port>0</port>
              </udpv4>
            </locator>
            <locator>
              <udpv4>
                <address>#host_ip</address>
                <port>0</port>
              </udpv4>
            </locator>
            <!--peer-block--><locator>
              <udpv4>
                <address>#peer</address>
                <port>0</port>
              </udpv4>
            </locator><!--/peer-block-->
          </initialPeersList>

          <discovery_config>
            <leaseDuration>
              <sec>60</sec>
            </leaseDuration>
            <leaseAnnouncement>
              <sec>10</sec>
            </leaseAnnouncement>
          </discovery_config>
        </builtin>

        <userTransports>
          <transport_id>rosotacom_ota_udp</transport_id>
        </userTransports>
        <useBuiltinTransports>false</useBuiltinTransports>
      </rtps>
    </participant>

    <data_writer profile_name="rosotacom_fastdds_tuned_writer" is_default_profile="true">
      <qos>
        <!-- Without this the writer is synchronous and cannot fragment. -->
        <data_sharing>
          <kind>OFF</kind>
        </data_sharing>
      </qos>
    </data_writer>

    <data_reader profile_name="rosotacom_fastdds_tuned_reader" is_default_profile="true">
      <qos>
        <data_sharing>
          <kind>OFF</kind>
        </data_sharing>
      </qos>
    </data_reader>
  </profiles>
</dds>
